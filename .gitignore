# =========================================
# IGNORE GENERATED DATA & SRIM OUTPUT
# =========================================
data/
*/data/
results/
*/results/

# Ignore any SRIM-generated text/csv files
*.txt
*.csv

# BUT keep important code CSVs (whitelist)
!src/**/*.csv
!tests/**/*.csv
!notebooks/**/*.csv

# =========================================
# IGNORE SRIM BINARIES
# =========================================
SRIM-2013/
*/SRIM-2013/

# =========================================
# IGNORE LARGE FILES
# =========================================
*.output
*.ion
*.save

# =========================================
# TRAINING LOGS (TensorBoard / SBI)
# =========================================
sbi-logs/
*/sbi-logs/
*.tfevents*

# =========================================
# PYTHON NOISE
# =========================================
__pycache__/
*.pyc
.DS_Store

# =========================================
# TEMP FILES
# =========================================
*.tmp
temp_*
